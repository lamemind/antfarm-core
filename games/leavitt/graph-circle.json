    {"id": "C", "type": "llm", "role": "player"},
    {"id": "D", "type": "llm", "role": "player"},
    {"id": "E", "type": "llm", "role": "player"}
  ],
  "edges": [
    {"from": "director", "to": "A", "rights": ["know", "write"]},
    {"from": "director", "to": "B", "rights": ["know", "write"]},
    {"from": "director", "to": "C", "rights": ["know", "write"]},
    {"from": "director", "to": "D", "rights": ["know", "write"]},
    {"from": "director", "to": "E", "rights": ["know", "write"]},
    {"from": "A", "to": "B", "rights": ["know", "write"]},
    {"from": "A", "to": "E", "rights": ["know", "write"]},
    {"from": "B", "to": "A", "rights": ["know", "write"]},
    {"from": "B", "to": "C", "rights": ["know", "write"]},
    {"from": "C", "to": "B", "rights": ["know", "write"]},
    {"from": "C", "to": "D", "rights": ["know", "write"]},
    {"from": "D", "to": "C", "rights": ["know", "write"]},
    {"from": "D", "to": "E", "rights": ["know", "write"]},
    {"from": "E", "to": "A", "rights": ["know", "write"]},
    {"from": "E", "to": "D", "rights": ["know", "write"]},
    {"from": "A", "to": "director", "rights": ["know", "write"]},
    {"from": "B", "to": "director", "rights": ["know", "write"]},
    {"from": "C", "to": "director", "rights": ["know", "write"]},
    {"from": "D", "to": "director", "rights": ["know", "write"]},
    {"from": "E", "to": "director", "rights": ["know", "write"]}
  ]
