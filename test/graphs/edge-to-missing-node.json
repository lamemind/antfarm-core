      "type": "script",
      "role": "launches the match and receives the arrival"
    },
    {
      "id": "A",
      "type": "llm",
      "role": "first link"
    },
    {
      "id": "B",
      "type": "llm",
      "role": "link"
    },
    {
      "id": "C",
      "type": "llm",
      "role": "link"
    },
    {
      "id": "D",
      "type": "llm",
      "role": "last link"
    }
  ],
  "edges": [
    {
      "from": "director",
      "to": "A",
      "rights": [
        "know",
        "write"
      ]
    },
    {
      "from": "A",
      "to": "Z",
      "rights": [
        "know",
        "write"
      ]
    },
    {
      "from": "B",
      "to": "C",
      "rights": [
        "know",
        "write"
      ]
    },
    {
      "from": "C",
      "to": "D",
      "rights": [
        "know",
        "write"
      ]
    },
    {
      "from": "D",
      "to": "director",
      "rights": [
        "know",
        "write"
      ]
    }
  ]
}
