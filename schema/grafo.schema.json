{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestra/grafo.schema.json",
  "title": "Grafo di accesso di una partita",
  "description": "Matrice di accesso: nodi, archi orientati con un insieme di diritti, versione. La coerenza fra archi e nodi (estremi esistenti, coppie non ripetute) la controlla valida-grafo.py, che lo schema da solo non esprime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["versione", "nodi", "archi"],
  "properties": {
    "versione": {
      "description": "Cresce a ogni modifica del grafo; ogni messaggio la porta.",
      "type": "integer",
      "minimum": 1
    },
    "descrizione": {"type": "string"},
    "nodi": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nodo"}
    },
    "archi": {
      "type": "array",
      "items": {"$ref": "#/$defs/arco"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
    },
    "nodo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tipo"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "tipo": {
          "description": "llm: una sessione di agente · script: un processo deterministico · umano: la persona · sorgente: un nodo che non parla",
          "enum": ["llm", "script", "umano", "sorgente"]
        },
        "ruolo": {"type": "string"},
        "percorso": {
          "description": "Solo per una sorgente: il file che la sorgente è, relativo alla cartella della partita. Chi ha `scrive` verso la sorgente lo scrive con `bus scrivi`. Assoluto o con `..` lo rifiuta valida-grafo.py.",
          "type": "string",
          "minLength": 1
        }
      },
      "if": {"properties": {"tipo": {"const": "sorgente"}}, "required": ["tipo"]},
      "then": {"required": ["percorso"]},
      "else": {"not": {"required": ["percorso"]}}
    },
    "arco": {
      "type": "object",
      "additionalProperties": false,
      "required": ["da", "a", "diritti"],
      "properties": {
        "da": {"$ref": "#/$defs/id"},
        "a": {"$ref": "#/$defs/id"},
        "diritti": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["conosce", "legge", "scrive", "modifica", "spawn"]}
        }
      }
    }
  }
}
