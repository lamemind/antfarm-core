#!/usr/bin/env python3
"""Message bus: the only piece of the engine that enforces the access graph.

    bus send <recipient> [text...]       delivers a message; without text it reads it from stdin
    bus recv [--wait <seconds>]          waits, blocked, for the first message of its own mailbox
    bus write <source> [text...]         writes the text into the file of the source, replacing its
                                         content; without text it reads it from stdin
    bus view                             prints its own view of the graph, with the current version

No command accepts the sender. The bus derives it from the process ancestry: it walks up
/proc from its own parent, and the first ancestor that an open match has registered in nodes.json
— pair (pid, starttime), written by the director at launch — is the caller. A caller that
no open match has registered is rejected with `unknown-sender`.

A source is a node that does not speak: a file, at the `path` that the graph declares relative to the
match directory. The right to write it is a `write` edge toward it, as for a
message: `write` checks it the same way as `send`. `send` toward a source and `write`
toward a node that is not a source are rejected with `wrong-type`.

Every send, delivered or rejected, every write and every receipt becomes a row of
registry/messages.jsonl; the write has outcome `written`. Rejection reasons: `edge-denied`,
`unknown-node`, `unknown-sender`, `wrong-type`.

Matches and log live under the state root, which the bus reads only from ANTFARM_STATE_DIR.

Exits 0 if it delivers, writes or receives, 1 if it rejects, 2 on wrong usage or without a state root,
3 if recv receives nothing within the wait.
"""

import fcntl
import json
import os
import sys
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import graph as libgraph  # noqa: E402
import view as libview  # noqa: E402

# The state root comes only from the environment, never from an argument: `Bash(<bus> *)` allows
# any argument, so the node could write it. The director puts it in ANTFARM_STATE_DIR
# as an absolute path; without it, the bus exits with an error.
STATE_ROOT = libgraph.state_root()
MATCHES = STATE_ROOT / "matches"
MESSAGE_LOG = STATE_ROOT / "registry" / "messages.jsonl"
MESSAGES_LOCK = STATE_ROOT / "registry" / ".messages.lock"
REGISTRATION_WAIT_S = 20
RECV_WAIT_DEFAULT_S = 600
RECV_WAIT_MAX_S = 840
POLLING_STEP_S = 0.5


class Rejection(Exception):
    def __init__(self, reason, detail):
        super().__init__(detail)
        self.reason = reason
        self.detail = detail


# <editor-fold defaultstate="collapsed" desc="Identity from the process ancestry">
def stat_fields(pid):
    """The fields of /proc/<pid>/stat from the third onward: the command name can contain spaces and parentheses."""
    with open(f"/proc/{pid}/stat", encoding="utf-8") as stat_file:
        content = stat_file.read()
    return content[content.rindex(")") + 2:].split()


def parent_and_start_time(pid):
    fields = stat_fields(pid)
    return int(fields[1]), int(fields[19])


def ancestors():
    """Pairs (pid, starttime) from the parent of the bus up to init, excluded."""
    chain = []
    pid = os.getppid()
    while pid > 1:
        try:
            parent_pid, start_time = parent_and_start_time(pid)
        except (FileNotFoundError, ProcessLookupError):
            break
        chain.append((pid, start_time))
        pid = parent_pid
    return chain


def is_claude_session(pid):
    try:
        executable = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        return False
    return "/claude/" in executable or Path(executable).name == "claude"


def open_registrations():
    """(pid, starttime) → (match directory, node), for every open match."""
    registrations = {}
    if not MATCHES.is_dir():
        return registrations
    for nodes_file in MATCHES.glob("*/nodes.json"):
        try:
            data = json.loads(nodes_file.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if data.get("status") != "open":
            continue
        for node_id, process in data.get("nodes", {}).items():
            if process.get("pid") and process.get("starttime"):
                registrations[(process["pid"], process["starttime"])] = (nodes_file.parent, node_id)
    return registrations


def identify():
    """The caller as (match directory, node). Waits for the registration up to 20 s,
    because the director registers a node only after its process has started."""
    chain = ancestors()
    timeout = time.monotonic() + REGISTRATION_WAIT_S
    while True:
        registrations = open_registrations()
        for pair in chain:
            if pair in registrations:
                return registrations[pair]
        if time.monotonic() >= timeout:
            break
        time.sleep(POLLING_STEP_S)
    sessions = [pid for pid, _ in chain if is_claude_session(pid)]
    who = f"sessione claude pid {sessions[0]}" if sessions else f"processo pid {os.getppid()}"
    raise Rejection("unknown-sender", f"{who} non è registrata in nessuna partita aperta")
# </editor-fold>


# <editor-fold defaultstate="collapsed" desc="Message log and mailboxes">
def now():
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="milliseconds")


def write_log(row):
    MESSAGE_LOG.parent.mkdir(parents=True, exist_ok=True)
    with open(MESSAGES_LOCK, "a", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with open(MESSAGE_LOG, "a", encoding="utf-8") as log:
            log.write(json.dumps(row, ensure_ascii=False) + "\n")


def mailbox(match_dir, node_id):
    return match_dir / "mailboxes" / node_id


def deposit(match_dir, message):
    directory = mailbox(match_dir, message["to"])
    directory.mkdir(parents=True, exist_ok=True)
    name = f"{time.time_ns()}-{message['id']}.json"
    temporary = directory / f".{name}"
    temporary.write_text(json.dumps(message, ensure_ascii=False), encoding="utf-8")
    os.rename(temporary, directory / name)


def take(match_dir, node_id):
    """The oldest message of the mailbox, moved to received/; None if the mailbox is empty."""
    directory = mailbox(match_dir, node_id)
    received = directory / "received"
    received.mkdir(parents=True, exist_ok=True)
    for message_file in sorted(directory.glob("[0-9]*.json")):
        try:
            os.rename(message_file, received / message_file.name)
        except FileNotFoundError:
            continue
        return json.loads((received / message_file.name).read_text(encoding="utf-8"))
    return None
# </editor-fold>


def rejection_row(rejection, match, sender, recipient, version, text):
    return {
        "ts": now(), "match": match, "id": None, "outcome": "rejected", "reason": rejection.reason,
        "from": sender, "to": recipient, "version": version, "text": text,
        "words": len(text.split()), "caller_pid": os.getppid(),
    }


def text_from_args(args):
    text = " ".join(args[1:]) if len(args) > 1 else sys.stdin.read()
    return text.strip()


def authorize(recipient, to_source):
    """Identifies the caller and checks node, type and `write` edge toward the recipient.
    Returns (match directory, sender, graph, departure time); raises Rejection with
    match, sender and version already known in its attributes, for the log row.

    The graph is reread on every command, so a version that the director writes while the match is open
    holds from the next command. Version and departure time are read under the shared lock:
    the director writes the time the version takes effect under the exclusive lock, and so a message
    that departed before the change always has an earlier time and the old version."""
    match_dir, sender = identify()
    with open(match_dir / libgraph.GRAPH_LOCK, "a", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_SH)
        graph = libgraph.load(match_dir / "graph.json")
        departure = now()
    version = graph["version"]
    context = {"match": match_dir.name, "sender": sender, "version": version}
    recipient_node = libgraph.node(graph, recipient)
    try:
        if recipient_node is None:
            raise Rejection("unknown-node", f"{recipient} non è un nodo del grafo v{version}")
        is_source = recipient_node["type"] == "source"
        if to_source and not is_source:
            raise Rejection("wrong-type", f"{recipient} non è una sorgente: a un nodo si scrive con `bus send`")
        if is_source and not to_source:
            raise Rejection("wrong-type", f"{recipient} è una sorgente, un file e non una casella: si scrive con `bus write`")
        if "write" not in libgraph.rights(graph, sender, recipient):
            raise Rejection("edge-denied", f"{sender} non ha `write` verso {recipient} nel grafo v{version}")
    except Rejection as rejection:
        rejection.context = context
        raise
    return match_dir, sender, graph, departure


def reject(rejection, recipient, text):
    context = getattr(rejection, "context", {"match": None, "sender": None, "version": None})
    write_log(rejection_row(rejection, context["match"], context["sender"], recipient, context["version"], text))
    print(f"rifiutato: {rejection.reason} — {rejection.detail}", file=sys.stderr)
    return 1


def command_send(args):
    if not args:
        print("uso: bus send <destinatario> [testo...]", file=sys.stderr)
        return 2
    recipient = args[0]
    text = text_from_args(args)
    if not text:
        print("testo vuoto: niente da consegnare", file=sys.stderr)
        return 2
    try:
        match_dir, sender, graph, departure = authorize(recipient, to_source=False)
    except Rejection as rejection:
        return reject(rejection, recipient, text)
    match, version = match_dir.name, graph["version"]
    message = {
        "ts": departure, "match": match, "id": f"m-{uuid.uuid4().hex[:12]}", "outcome": "delivered",
        "reason": None, "from": sender, "to": recipient, "version": version, "text": text,
        "words": len(text.split()), "caller_pid": os.getppid(),
    }
    deposit(match_dir, message)
    write_log(message)
    print(f"consegnato a {recipient} · messaggio {message['id']} · grafo v{version}")
    return 0


def source_file_path(match_dir, source_node):
    """The file of the source, inside the match directory. The graph validator already rejects
    an absolute path or one with `..`; the check here covers a symbolic link that leads outside."""
    root = match_dir.resolve()
    path = (root / source_node["path"]).resolve()
    if root not in path.parents:
        raise Rejection("wrong-type", f"il percorso di {source_node['id']} esce dalla cartella della partita")
    return path


def command_write(args):
    if not args:
        print("uso: bus write <sorgente> [testo...]", file=sys.stderr)
        return 2
    source = args[0]
    text = text_from_args(args)
    if not text:
        print("testo vuoto: niente da scrivere", file=sys.stderr)
        return 2
    try:
        match_dir, sender, graph, departure = authorize(source, to_source=True)
        try:
            path = source_file_path(match_dir, libgraph.node(graph, source))
        except Rejection as rejection:
            rejection.context = {"match": match_dir.name, "sender": sender, "version": graph["version"]}
            raise
    except Rejection as rejection:
        return reject(rejection, source, text)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{uuid.uuid4().hex[:8]}")
    temporary.write_text(text + "\n", encoding="utf-8")
    os.replace(temporary, path)
    row = {
        "ts": departure, "match": match_dir.name, "id": f"m-{uuid.uuid4().hex[:12]}", "outcome": "written",
        "reason": None, "from": sender, "to": source, "version": graph["version"], "text": text,
        "words": len(text.split()), "caller_pid": os.getppid(),
    }
    write_log(row)
    print(f"scritto in {source} · {row['id']} · grafo v{graph['version']}")
    return 0


def command_recv(args):
    wait = RECV_WAIT_DEFAULT_S
    if args[:1] == ["--wait"] and len(args) == 2 and args[1].isdigit():
        wait = min(int(args[1]), RECV_WAIT_MAX_S)
    elif args:
        print("uso: bus recv [--wait <secondi>]", file=sys.stderr)
        return 2
    try:
        match_dir, recipient = identify()
    except Rejection as rejection:
        write_log(rejection_row(rejection, None, None, None, None, ""))
        print(f"rifiutato: {rejection.reason} — {rejection.detail}", file=sys.stderr)
        return 1
    timeout = time.monotonic() + wait
    while True:
        message = take(match_dir, recipient)
        if message is not None:
            break
        if time.monotonic() >= timeout:
            print(f"nessun messaggio entro {wait} s: richiama bus recv per continuare ad aspettare")
            return 3
        time.sleep(POLLING_STEP_S)
    write_log({
        "ts": now(), "match": match_dir.name, "id": message["id"], "outcome": "received",
        "reason": None, "from": message["from"], "to": recipient, "version": message["version"],
        "text": None, "words": message["words"], "caller_pid": os.getppid(),
    })
    print(f"messaggio {message['id']} da {message['from']} · grafo v{message['version']}")
    print("---")
    print(message["text"])
    return 0


def command_view(args):
    if args:
        print("uso: bus view", file=sys.stderr)
        return 2
    try:
        match_dir, node_id = identify()
    except Rejection as rejection:
        print(f"rifiutato: {rejection.reason} — {rejection.detail}", file=sys.stderr)
        return 1
    graph = libgraph.load(match_dir / "graph.json")
    print(libview.as_text(libview.view(graph, node_id)))
    return 0


def main():
    commands = {"send": command_send, "recv": command_recv, "write": command_write, "view": command_view}
    if len(sys.argv) < 2 or sys.argv[1] not in commands:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return commands[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    sys.exit(main())
